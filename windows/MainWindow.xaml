<Window x:Class="DimaAI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dima AI" Width="1120" Height="760" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="278" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="#292F27" BorderThickness="0,0,1,0">
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource AccentBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="D" FontSize="24" FontWeight="Bold"
                                   Foreground="#11140F" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="DIMA AI" Margin="0,18,0,3" FontSize="17"
                               FontWeight="Bold" />
                    <TextBlock Text="Qwen3 · локальный режим" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="ModelStateText" Text="Модель ещё не загружена"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ProgressBar x:Name="ModelProgress" Height="5" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" Margin="0,0,0,12" />
                    <Button x:Name="ModelButton" Content="Скачать Qwen · 1,28 ГБ"
                            Click="ModelButton_Click" HorizontalContentAlignment="Center" />
                    <TextBlock Text="Для загрузки нужно 1,4 ГБ места. Для работы модели желательно около 2,5 ГБ свободной RAM."
                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                               TextWrapping="Wrap" Margin="2,10,2,0" LineHeight="17" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PageBrush}"
                    BorderBrush="#252A23" BorderThickness="0,0,0,1">
                <Grid Margin="24,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Локальный чат" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="ConnectionStateText" Text="Готов к работе"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="InternetButton" Content="Интернет: ВКЛ"
                                Background="{StaticResource RaisedBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                                Click="InternetButton_Click" Margin="0,0,8,0" />
                        <Button Content="Новый чат" Background="{StaticResource RaisedBrush}"
                                Foreground="{StaticResource PrimaryTextBrush}" Click="NewChatButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center"
                                VerticalAlignment="Center" MaxWidth="560" Margin="36">
                        <TextBlock Text="DIMA · QWEN3" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="Привет, Дима.&#10;С чего начнём?" FontSize="34"
                                   FontWeight="SemiBold" LineHeight="42" Margin="0,12,0,8" />
                        <TextBlock Text="Скачай модель один раз — дальше она отвечает на этом компьютере без облака."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="14"
                                   TextWrapping="Wrap" LineHeight="22" />
                    </StackPanel>
                    <StackPanel x:Name="ChatMessages" Margin="28,24" />
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource PageBrush}"
                    BorderBrush="#252A23" BorderThickness="0,1,0,0" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MessageInput" MinHeight="46" MaxHeight="120"
                             VerticalContentAlignment="Center" AcceptsReturn="True"
                             TextWrapping="Wrap" KeyDown="MessageInput_KeyDown"
                             ToolTip="Сообщение или публичная HTTPS-ссылка на страницу" />
                    <Button x:Name="SendButton" Grid.Column="1" Content="Отправить" Click="SendButton_Click"
                            Margin="10,0,0,0" MinWidth="100" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>